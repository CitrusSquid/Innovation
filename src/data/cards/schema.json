{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Innovation 4th Edition Card Age File",
  "type": "object",
  "required": ["age", "set", "cards"],
  "additionalProperties": false,
  "properties": {
    "age": {
      "type": "integer",
      "minimum": 1,
      "maximum": 11
    },
    "set": {
      "type": "string",
      "enum": ["base"]
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rawId", "age", "name", "color", "icons", "abilities"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^B\\d{3}$"
          },
          "rawId": {
            "type": "string"
          },
          "age": {
            "type": "integer",
            "minimum": 1,
            "maximum": 11
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "enum": ["red", "yellow", "green", "blue", "purple"]
          },
          "icons": {
            "type": "object",
            "required": ["tl", "bl", "bc", "br"],
            "additionalProperties": false,
            "properties": {
              "tl": { "$ref": "#/$defs/iconSlot" },
              "bl": { "$ref": "#/$defs/iconSlot" },
              "bc": { "$ref": "#/$defs/iconSlot" },
              "br": { "$ref": "#/$defs/iconSlot" }
            }
          },
          "abilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["index", "icon", "isDemand", "text"],
              "additionalProperties": false,
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 1
                },
                "icon": {
                  "type": "string",
                  "enum": ["tower", "coin", "leaf", "lightbulb", "factory", "clock", "persona"]
                },
                "isDemand": {
                  "type": "boolean"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "iconSlot": {
      "type": "string",
      "enum": ["hexagon", "tower", "coin", "leaf", "lightbulb", "factory", "clock", "persona"]
    }
  }
}
